    "skillId": "frac.reciprocal",
    "estimatedMinutes": 3,
    "courseId": "g6-fraction-div",
    "diagnosticQuestions": [
      {
        "id": "rep-recip-d1",
        "type": "fill-blank",
        "prompt": "3/7 的倒数是多少？（用a/b格式）",
        "correctAnswer": "7/3",
        "explanation": "倒数就是分子和分母互换：3/7的倒数是7/3，因为3/7 × 7/3 = 21/21 = 1。",
        "points": 10,
        "primarySkillId": "frac.reciprocal",
        "evidenceType": "procedural"
      },
      {
        "id": "rep-recip-d2",
        "type": "choice",
        "prompt": "两个数互为倒数，它们的积是多少？",
        "options": [
          "0",
          "本身",
          "1",
          "2"
        ],
        "correctAnswer": "1",
        "explanation": "互为倒数的两个数乘积为1，这是倒数的定义。",
        "points": 10,
        "primarySkillId": "frac.reciprocal",
        "evidenceType": "conceptual"
      }
    ],
    "lesson": {
      "coreExplanation": "倒数：把一个分数的分子和分母互换，两数相乘等于1。",
      "steps": [
        "找到原分数 a/b。",
        "把分子分母互换，得到 b/a。",
        "验证：a/b × b/a = ab/ab = 1，确认是倒数。",
        "特殊情况：1的倒数是1；0没有倒数（0×任何数≠1）。"
      ],
      "workedExample": {
        "question": "5/6 的倒数是多少？验证一下。",
        "steps": [
          "把5/6分子分母互换，得6/5。",
          "验证：5/6 × 6/5 = 30/30 = 1 ✓。"
        ],
        "answer": "6/5"
      },
      "misconception": {
        "mistake": "认为整数没有倒数（如认为4没有倒数）。",
        "correction": "整数4可以写成4/1，倒数是1/4。因为4 × 1/4 = 1，满足倒数定义。"
      }
    },
    "checkQuestions": [
      {
