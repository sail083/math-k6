    "diagnosticQuestions": [
      {
        "id": "rep-eqpart-d1",
        "type": "choice",
        "prompt": "下面哪种切法是“平均分”？",
        "options": [
          "把一个西瓜切成一大块和一小块",
          "把8颗糖分成4份，每份2颗",
          "把一张纸随便撕成3片",
          "把一根胡萝卜切成长短不等的两段"
        ],
        "correctAnswer": "把8颗糖分成4份，每份2颗",
        "explanation": "平均分要求每份大小相同。只有“4份每份2颗”做到了每份相等。",
        "points": 10,
        "primarySkillId": "frac.equal_partition",
        "evidenceType": "conceptual"
      },
      {
        "id": "rep-eqpart-d2",
        "type": "choice",
        "prompt": "把12个橘子分给3个小朋友，平均每人得到几个？",
        "options": [
          "3个",
          "4个",
          "6个",
          "12个"
        ],
        "correctAnswer": "4个",
        "explanation": "12÷3=4，平均分即每份相同，每人4个。",
        "points": 10,
        "primarySkillId": "frac.equal_partition",
        "evidenceType": "procedural"
      }
    ],
    "lesson": {
      "coreExplanation": "平均分就是把整体分成若干份，每一份的大小完全相同——不多不少，一样大。",
      "steps": [
        "分成几份？数数份数。",
        "检查每份是否一样大（一样多）。",
        "每份都相同 → 平均分；有大有小 → 不是平均分。"
      ],
      "workedExample": {
        "question": "把10块饼干分成5份，是平均分吗？每份几块？",
        "steps": [
          "10÷5=2，每份2块。",
          "每份都是2块，大小相同 → 是平均分。"
        ],
        "answer": "是平均分，每份2块"
      },
      "misconception": {
        "mistake": "只看“分了几份”，不看每份是否一样大。",
        "correction": "平均分必须每份相等。把10个苹果分成“3、3、4”就不是平均分，因为最后一份多了1个。"
      }
    },
    "checkQuestions": [
      {
        "id": "rep-eqpart-c1",
