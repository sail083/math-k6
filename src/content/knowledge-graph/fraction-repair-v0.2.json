    "lesson": {
      "coreExplanation": "求“一个量的几分之几”就是乘法：整体 × 分数 = 结果。",
      "steps": [
        "找到题目里的整体（单位“1”），记为“整体”。",
        "找到分数（几分之几）。",
        "列式：整体 × 分数。",
        "计算结果。"
      ],
      "workedExample": {
        "question": "一段路全长30千米，已走完了2/5，走了多少千米？",
        "steps": [
          "整体 = 30千米（全长）。",
          "分数 = 2/5（已走完的部分）。",
          "30 × 2/5 = 60/5 = 12千米。"
        ],
        "answer": "12千米"
      },
      "misconception": {
        "mistake": "把“求几分之几”误用成除法（整体 ÷ 分数）。",
        "correction": "求几分之几是乘法。除法是知道部分求整体，或者知道倍数关系求个数。“求3/4”就是乘3/4。"
      }
