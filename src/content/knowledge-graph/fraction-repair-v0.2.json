    "lesson": {
      "coreExplanation": "两个分数相乘：分子乘分子、分母乘分母，结果化最简。",
      "steps": [
        "写出两个分数：a/b × c/d。",
        "分子相乘：a × c = 新分子。",
        "分母相乘：b × d = 新分母。",
        "结果化为最简分数。"
      ],
      "workedExample": {
        "question": "计算 3/4 × 2/9",
        "steps": [
          "分子：3 × 2 = 6。",
          "分母：4 × 9 = 36。",
          "结果：6/36，约分得 1/6。"
        ],
        "answer": "1/6"
      },
      "misconception": {
        "mistake": "分子与分母交叉相乘（如3/4×2/9误算成3×9=27，4×2=8，得27/8）。",
        "correction": "乘法是“同位相乘”：上面（分子）×上面，下面（分母）×下面。交叉相乘是错误的。"
      }
    },
