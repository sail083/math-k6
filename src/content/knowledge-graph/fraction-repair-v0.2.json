      {
        "id": "rep-notation-d2",
        "type": "choice",
        "prompt": "把一个圆平均分成8份，取其中3份。这个分数怎么写？",
        "options": [
          "8/3",
          "3/8",
          "3/5",
          "5/8"
        ],
        "correctAnswer": "3/8",
        "explanation": "分母=分成的份数=8，分子=取的份数=3，所以是3/8。",
