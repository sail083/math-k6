        ],
        "correctAnswer": "对折两次，得4个大小相等的扇形",
        "explanation": "对折两次每份面积相同，是平均分。其他方式每份大小不一样。",
        "points": 10,
        "primarySkillId": "frac.equal_partition",
        "evidenceType": "transfer"
      },
