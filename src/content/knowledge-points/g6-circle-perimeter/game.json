{
  "knowledgePointId": "g6-circle-perimeter",
  "passThreshold": 0.8,
  "questions": [
    {
      "id": "q1",
      "type": "choice",
      "prompt": "圆的周长公式是什么？",
      "options": [
        "C = πd = 2πr",
        "C = πr",
        "C = 2d",
        "C = πr²"
      ],
      "correctAnswer": "C = πd = 2πr",
      "explanation": "圆的周长 = π × 直径 = 2 × π × 半径，即 C = πd = 2πr。π ≈ 3.14。",
      "points": 10
    },
    {
      "id": "q2",
      "type": "choice",
      "prompt": "直径是10厘米的圆，周长约是多少？（π取3.14）",
      "options": [
        "31.4厘米",
        "20厘米",
        "62.8厘米",
        "15.7厘米"
      ],
      "correctAnswer": "31.4厘米",
      "explanation": "C = πd = 3.14 × 10 = 31.4（厘米）。",
      "points": 10
    },
    {
      "id": "q3",
      "type": "choice",
      "prompt": "半径是5厘米的圆，周长约是多少？（π取3.14）",
      "options": [
        "15.7厘米",
        "31.4厘米",
        "78.5厘米",
        "10厘米"
      ],
      "correctAnswer": "31.4厘米",
      "explanation": "C = 2πr = 2 × 3.14 × 5 = 31.4（厘米）。",
      "points": 10
    },
    {
      "id": "q4",
      "type": "choice",
      "prompt": "圆周率 π 大约等于多少？",
      "options": [
        "3",
        "3.14",
        "3.41",
        "31.4"
      ],
      "correctAnswer": "3.14",
      "explanation": "π 是一个无限不循环小数，约等于 3.14159...，平时计算取 3.14。",
      "points": 10
    },
    {
      "id": "q5",
      "type": "choice",
      "prompt": "周长是62.8厘米的圆，直径是多少？（π取3.14）",
      "options": [
        "10厘米",
        "20厘米",
        "31.4厘米",
        "15厘米"
      ],
      "correctAnswer": "20厘米",
      "explanation": "由 C = πd 得 d = C ÷ π = 62.8 ÷ 3.14 = 20（厘米）。",
      "points": 10
    },
    {
      "id": "q6",
      "type": "fill-blank",
      "prompt": "迁移题：圆的直径是10厘米，取π=3.14，周长是多少厘米？",
      "correctAnswer": [
        "31.4",
        "31.4厘米"
      ],
      "explanation": "圆滚动一周展开的长度是周长，C=πd=3.14×10=31.4厘米。",
      "points": 10
    }
  ],
  "reviewSets": {
    "d1": {
      "questions": [
        {
          "id": "d1-choice",
          "type": "choice",
          "prompt": "圆的直径扩大到原来的3倍，周长扩大到原来的多少倍？",
          "options": [
            "3倍",
            "6倍",
            "9倍",
            "12倍"
          ],
          "correctAnswer": "3倍",
          "explanation": "C = πd，周长与直径成正比。直径扩大3倍，周长也扩大3倍。",
          "points": 10
        },
        {
          "id": "d1-fill",
          "type": "fill-blank",
          "prompt": "一个圆的周长是94.2厘米，它的半径是多少厘米？（π取3.14）",
          "correctAnswer": [
            "15",
            "15厘米"
          ],
          "explanation": "由 C = 2πr 得 r = C ÷ (2π) = 94.2 ÷ (2 × 3.14) = 94.2 ÷ 6.28 = 15（厘米）。",
          "points": 10
        }
      ]
    },
    "d7": {
      "questions": [
        {
          "id": "d7-choice",
          "type": "choice",
          "prompt": "同一个圆的周长除以直径，商大约是多少？",
          "options": [
            "3.14",
            "3",
            "6.28",
            "1.57"
          ],
          "correctAnswer": "3.14",
          "explanation": "同一个圆中，周长 ÷ 直径 = 圆周率π，π ≈ 3.14。无论圆的大小如何，这个比值都相同，这正是圆周率的意义。",
          "points": 10
        },
        {
          "id": "d7-fill",
          "type": "fill-blank",
          "prompt": "自行车车轮的直径是0.5米，车轮滚动10圈，自行车前进多少米？（π取3.14）",
          "correctAnswer": [
            "15.7",
            "15.7米"
          ],
          "explanation": "一圈距离 = πd = 3.14 × 0.5 = 1.57（米），10圈 = 1.57 × 10 = 15.7（米）。",
          "points": 10
        }
      ]
    }
  }
}
