{
  "knowledgePointId": "g6-fraction-div",
  "passThreshold": 0.8,
  "questions": [
    {
      "id": "q1",
      "type": "choice",
      "prompt": "1/3 的倒数是？",
      "options": ["3", "1/3", "3/3", "0"],
      "correctAnswer": "3",
      "explanation": "把 1/3 的分子分母颠倒，得到 3/1 = 3。1/3 的倒数是 3。",
      "points": 10,
      "primarySkillId": "frac.reciprocal",
      "evidenceType": "conceptual"
    },
    {
      "id": "q2",
      "type": "choice",
      "prompt": "1 ÷ 1/3 的结果是多少？",
      "options": ["1/3", "3", "3/1", "1"],
      "correctAnswer": "3",
      "explanation": "1 里面有3个 1/3，所以 1 ÷ 1/3 = 3。也可以用法则：1 ÷ 1/3 = 1 × 3 = 3。",
      "points": 10,
      "primarySkillId": "frac.division_grouping",
      "evidenceType": "conceptual"
    },
    {
      "id": "q3",
      "type": "choice",
      "prompt": "2/3 ÷ 4/5 的结果是多少？",
      "options": ["8/15", "5/6", "10/12", "6/5"],
      "correctAnswer": "5/6",
      "explanation": "2/3 ÷ 4/5 = 2/3 × 5/4 = 10/12 = 5/6。除号变乘号，4/5 变倒数 5/4，再按乘法算。",
      "points": 10,
      "primarySkillId": "frac.divide_transform",
      "evidenceType": "procedural"
    },
    {
      "id": "q4",
      "type": "choice",
      "prompt": "分数除法的法则是？",
      "options": [
        "除以一个数等于乘这个数的倒数",
        "除以一个数等于除以它的倒数",
        "分子除分子，分母除分母",
        "分母相乘，分子不变"
      ],
      "correctAnswer": "除以一个数等于乘这个数的倒数",
      "explanation": "分数除法法则：除以一个数（不为0）等于乘这个数的倒数。即 a/b ÷ c/d = a/b × d/c。",
      "points": 10,
      "primarySkillId": "frac.divide_transform",
      "evidenceType": "conceptual"
    },
    {
      "id": "q5",
      "type": "choice",
      "prompt": "把 3/4 米长的绳子平均分成 3 份，每份是多少米？",
      "options": ["1/4", "1/3", "3/4", "3"],
      "correctAnswer": "1/4",
      "explanation": "3/4 米平均分成 3 份，每份是 3/4 ÷ 3 = 3/4 × 1/3 = 1/4 米。这是平均分除法（每份多少）。",
      "points": 10,
      "primarySkillId": "frac.division_sharing",
      "evidenceType": "procedural"
    },
    {
      "id": "q6",
      "type": "fill-blank",
      "prompt": "迁移题：把3/4改写成6/8，其中包含几个1/8？",
      "correctAnswer": "6",
      "explanation": "3/4=6/8，所以3/4里面正好包含6个1/8，即3/4÷1/8=6。",
      "points": 10,
      "primarySkillId": "frac.division_grouping",
      "evidenceType": "transfer"
    }
  ],
