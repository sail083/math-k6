    {
      "id": "q1",
      "type": "choice",
      "prompt": "圆柱体积公式是什么？",
      "options": [
        "V = πr²h",
        "V = πrh",
        "V = 2πrh",
        "V = πr² + h"
      ],
      "correctAnswer": "V = πr²h",
      "explanation": "圆柱体积 = 底面积 × 高 = πr² × h = πr²h。把圆柱底面切分拼成近似长方形，变成近似长方体，用底面积乘高算体积。",
      "points": 10
    },
    {
      "id": "q2",
      "type": "choice",
      "prompt": "圆柱底面半径3厘米，高5厘米，体积是多少？（π取3.14）",
      "options": [
        "141.3立方厘米",
        "47.1立方厘米",
        "28.26立方厘米",
        "15立方厘米"
      ],
      "correctAnswer": "141.3立方厘米",
      "explanation": "底面积 = πr² = 3.14 × 3² = 3.14 × 9 = 28.26；V = 28.26 × 5 = 141.3（立方厘米）。",
      "points": 10
    },
    {
      "id": "q3",
      "type": "choice",
      "prompt": "推导圆柱体积公式时，把圆柱变成了什么图形？",
