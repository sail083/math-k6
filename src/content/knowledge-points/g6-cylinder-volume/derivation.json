          {
            "id": "f-1",
            "type": "text",
            "x": 200,
            "y": 115,
            "text": "长方体体积 = 底面积 × 高",
            "fontSize": 14,
            "textFill": "#374151",
            "data": { "anchor": "middle" }
          },
          {
            "id": "f-2",
            "type": "text",
            "x": 200,
            "y": 145,
            "text": "= πr² × h",
            "fontSize": 16,
            "textFill": "#4f46e5",
            "data": { "anchor": "middle" }
          },
          {
            "id": "f-3",
            "type": "text",
            "x": 200,
            "y": 178,
            "text": "= πr²h",
            "fontSize": 18,
            "textFill": "#059669",
            "data": { "anchor": "middle" }
          }
