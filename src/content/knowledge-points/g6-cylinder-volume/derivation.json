        "labels": [
          { "text": "直柱体体积 = 底面积 × 高", "x": 200, "y": 235, "fontSize": 14, "fill": "#6b7280" }
        ],
        "formula": "V = πr²h"
      },
      "hint": "底面积 πr² × 高 h = πr²h"
    },
    {
      "title": "验证举例",
      "narration": "比如半径 3 厘米、高 5 厘米的圆柱：底面积 = 3.14 × 9 = 28.26，体积 = 28.26 × 5 = 141.3 立方厘米。",
      "scene": {
