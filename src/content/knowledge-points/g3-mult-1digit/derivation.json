            "showCount": false,
            "fill": "#818cf8",
            "stroke": "#d1d5db",
            "data": { "showLabels": true }
          },
          {
            "id": "result-text",
            "type": "text",
            "x": 200,
            "y": 240,
            "text": "12 × 3 = 36",
            "fontSize": 22,
            "textFill": "#4f46e5"
          }
        ],
        "labels": []
      },
      "hint": "乘法 = 求几个相同加数的和的简便运算"
    },
    {
      "title": "归纳公式",
      "narration": "每行的个数用 a 表示，行数用 b 表示，那么总数就是 a × b。不管数字多大，乘法都是这个道理——求 b 个 a 相加的和。",
      "scene": {
        "shapes": [
          {
            "id": "formula-rect",
            "type": "rect",
            "x": 100,
            "y": 100,
            "width": 200,
            "height": 80,
            "fill": "#eef2ff",
            "stroke": "#6366f1",
            "strokeWidth": 2,
            "radius": 8
          },
          {
            "id": "formula-text",
            "type": "text",
            "x": 200,
            "y": 140,
            "text": "a × b",
            "fontSize": 28,
            "textFill": "#4f46e5",
            "data": { "anchor": "middle" }
          }
        ],
        "labels": [
          { "text": "a = 每行的个数（多位数）", "x": 200, "y": 220, "fontSize": 13, "fill": "#6b7280" },
          { "text": "b = 行数（一位数）", "x": 200, "y": 245, "fontSize": 13, "fill": "#6b7280" }
        ],
        "formula": "a × b"
      },
      "hint": "b 个 a 相加 = a × b"
    }
  ]
}
