            "showCount": true,
            "fill": "#818cf8",
            "stroke": "#d1d5db",
            "data": { "animated": true }
          }
        ],
        "labels": [
          { "text": "每行 12 个 × 3 行 = 36", "x": 200, "y": 210, "fontSize": 16, "fill": "#4f46e5" }
        ]
