      "id": "q1",
      "type": "choice",
      "prompt": "1/5 + 2/5 的结果是多少？",
      "options": ["3/10", "3/5", "2/5", "3/25"],
      "correctAnswer": "3/5",
      "explanation": "同分母分数相加，分母不变，分子相加：1/5 + 2/5 = (1+2)/5 = 3/5。",
      "points": 10,
      "primarySkillId": "frac.add_sub_same_denominator",
      "evidenceType": "conceptual"
    },
