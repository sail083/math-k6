        "labels": [
          { "text": "角1 + 角2 + 角3 = 180°", "x": 200, "y": 210, "fontSize": 15, "fill": "#6b7280" },
          { "text": "不管什么三角形都一样！", "x": 200, "y": 240, "fontSize": 14, "fill": "#9ca3af" }
        ],
        "formula": "内角和 = 180°"
      },
      "hint": "任何三角形的内角和都是180°"
    }
