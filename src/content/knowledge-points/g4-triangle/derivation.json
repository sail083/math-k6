            "points": [{"x": 180, "y": 170}, {"x": 300, "y": 110}, {"x": 180, "y": 110}],
            "fill": "#fef3c7",
            "stroke": "#f59e0b",
            "strokeWidth": 2
          },
          {
            "id": "straight-label",
            "type": "text",
            "x": 200,
            "y": 185,
            "text": "←— 一条直线 = 180° —→",
            "fontSize": 13,
            "textFill": "#9ca3af"
          }
        ],
        "labels": [
          { "text": "三个角拼在一起 = 一条直线", "x": 200, "y": 230, "fontSize": 15, "fill": "#4f46e5" },
          { "text": "所以内角和 = 180°", "x": 200, "y": 255, "fontSize": 14, "fill": "#6b7280" }
        ]
      },
      "hint": "三个角拼在一起刚好是一条直线"
    },
    {
      "title": "归纳结论",
      "narration": "不管三角形是什么形状、大还是小，三个内角撕下来拼在一起，都刚好拼成一条直线。所以三角形的内角和永远等于180°！这就是三角形内角和定理。",
      "scene": {
