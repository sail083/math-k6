            "fontSize": 12,
            "textFill": "#f59e0b"
          }
        ],
        "labels": [
          { "text": "把三个角撕下来", "x": 200, "y": 220, "fontSize": 14, "fill": "#6b7280" },
          { "text": "准备拼在一起", "x": 200, "y": 245, "fontSize": 13, "fill": "#9ca3af" }
        ]
      },
      "hint": "把三个角撕下来，准备拼"
