{
  "knowledgePointId": "g6-percentage",
  "passThreshold": 0.8,
  "questions": [
    {
      "id": "q1",
      "type": "choice",
      "prompt": "百分数表示什么？",
      "options": [
        "一个数是另一个数的百分之几",
        "一个数是另一个数的几倍",
        "分母是10的分数",
        "带单位名称的数"
      ],
      "correctAnswer": "一个数是另一个数的百分之几",
      "explanation": "百分数表示一个数是另一个数的百分之几，也叫百分率或百分比。百分数只表示倍数关系，不带单位。",
      "points": 10
    },
    {
      "id": "q2",
      "type": "choice",
      "prompt": "把0.36化成百分数是多少？",
      "options": [
        "3.6%",
        "36%",
        "360%",
        "0.36%"
      ],
      "correctAnswer": "36%",
      "explanation": "小数化百分数：小数点向右移两位，加百分号。0.36 → 36%。",
      "points": 10
    },
    {
      "id": "q3",
      "type": "choice",
      "prompt": "班里有50人，今天出勤48人，出勤率是多少？",
      "options": [
        "48%",
        "50%",
        "96%",
        "52%"
      ],
      "correctAnswer": "96%",
      "explanation": "出勤率 = 48 ÷ 50 = 0.96 = 96%。出勤人数除以总人数再化成百分数。",
      "points": 10
    },
    {
      "id": "q4",
      "type": "choice",
      "prompt": "一件商品原价200元，现在打八折出售，现价是多少？",
      "options": [
        "160元",
        "80元",
        "40元",
        "180元"
      ],
      "correctAnswer": "160元",
      "explanation": "八折 = 80%，现价 = 200 × 80% = 200 × 0.8 = 160（元）。",
      "points": 10
    },
    {
      "id": "q5",
      "type": "choice",
      "prompt": "下面哪个说法是正确的？",
      "options": [
        "百分数可以带单位名称",
        "50%和1/2表示的大小关系相同",
        "出勤率可以超过100%",
        "25%化成小数是0.025"
      ],
      "correctAnswer": "50%和1/2表示的大小关系相同",
      "explanation": "50% = 50/100 = 1/2，两者表示的大小关系相同。百分数不带单位，出勤率最多100%，25% = 0.25（不是0.025）。",
      "points": 10
    },
    {
      "id": "q6",
      "type": "fill-blank",
      "prompt": "迁移题：35%写成小数是？",
      "correctAnswer": "0.35",
      "explanation": "35%=35/100=0.35。百分号表示分母固定为100。",
      "points": 10
    }
  ],
  "reviewSets": {
    "d1": {
      "questions": [
        {
          "id": "d1-choice",
          "type": "choice",
          "prompt": "把7/20化成百分数是多少？",
          "options": [
            "35%",
            "7%",
            "0.35%",
            "3.5%"
          ],
          "correctAnswer": "35%",
          "explanation": "7/20 = 7 ÷ 20 = 0.35 = 35%。也可以分子分母同乘5得到35/100 = 35%。",
          "points": 10
        },
        {
          "id": "d1-fill",
          "type": "fill-blank",
          "prompt": "一件衣服原价120元，打七五折后的售价是多少元？",
          "correctAnswer": [
            "90",
            "90元"
          ],
          "explanation": "七五折 = 75%，售价 = 120 × 75% = 120 × 0.75 = 90（元）。",
          "points": 10
        }
      ]
    },
    "d7": {
      "questions": [
        {
          "id": "d7-choice",
          "type": "choice",
          "prompt": "某工厂今年产量比去年增长25%，今年产量是去年的百分之几？",
          "options": [
            "25%",
            "75%",
            "125%",
            "100%"
          ],
          "correctAnswer": "125%",
          "explanation": "增长25%表示今年比去年多25%，今年 = 去年 ×（1 + 25%）= 去年 × 125%。注意：增长率可以超过100%，这与出勤率等不能超100%的百分率不同。",
          "points": 10
        },
        {
          "id": "d7-fill",
          "type": "fill-blank",
          "prompt": "某商品的成本价是80元，售价是100元，利润率（利润占成本的百分之几）是多少？",
          "correctAnswer": [
            "25%",
            "25"
          ],
          "explanation": "利润 = 售价 − 成本 = 100 − 80 = 20（元），利润率 = 20 ÷ 80 = 0.25 = 25%。",
          "points": 10
        }
      ]
    }
  }
}
