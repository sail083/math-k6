{
  "knowledgePointId": "g6-ratio",
  "passThreshold": 0.8,
  "questions": [
    {
      "id": "q1",
      "type": "choice",
      "prompt": "2 : 5 的比值是多少？",
      "options": [
        "2/5",
        "5/2",
        "2.5",
        "10"
      ],
      "correctAnswer": "2/5",
      "explanation": "比值 = 前项 ÷ 后项 = 2 ÷ 5 = 2/5（也可以写成 0.4）。",
      "points": 10
    },
    {
      "id": "q2",
      "type": "choice",
      "prompt": "6 : 4 化成最简比是？",
      "options": [
        "3 : 2",
        "2 : 3",
        "6 : 4",
        "1 : 2"
      ],
      "correctAnswer": "3 : 2",
      "explanation": "前项和后项同时除以最大公因数2：6÷2=3，4÷2=2，所以 6:4 = 3:2。",
      "points": 10
    },
    {
      "id": "q3",
      "type": "choice",
      "prompt": "在比 a : b 中，b 叫做什么？",
      "options": [
        "前项",
        "后项",
        "比值",
        "比号"
      ],
      "correctAnswer": "后项",
      "explanation": "在比 a : b 中，a 叫前项，b 叫后项，: 叫比号，a÷b 的结果叫比值。",
      "points": 10
    },
    {
      "id": "q4",
      "type": "choice",
      "prompt": "关于比 a : b，下面哪个说法正确？",
      "options": [
        "比的后项可以为0",
        "比的后项 b 不能为 0",
        "比和除法完全没关系",
        "比值必须大于1"
      ],
      "correctAnswer": "比的后项 b 不能为 0",
      "explanation": "a:b 与 a÷b 对应，所以后项 b 不能为0。不同类量相比得到的比值可能带单位，例如路程与时间的比值是速度。",
      "points": 10
    },
    {
      "id": "q5",
      "type": "choice",
      "prompt": "12 : 18 化成最简比是？",
      "options": [
        "2 : 3",
        "3 : 2",
        "6 : 9",
        "4 : 6"
      ],
      "correctAnswer": "2 : 3",
      "explanation": "12和18的最大公因数是6，12÷6=2，18÷6=3，所以 12:18 = 2:3。",
      "points": 10
    },
    {
      "id": "q6",
      "type": "fill-blank",
      "prompt": "迁移题：把6:9化成最简整数比。",
      "correctAnswer": [
        "2:3",
        "2：3",
        "2 : 3"
      ],
      "explanation": "6和9同时除以最大公因数3，得到2:3；比值保持不变。",
      "points": 10
    }
  ],
