        {
          "id": "d1-fill",
          "type": "fill-blank",
          "prompt": "一杯糖水中糖和水的质量比是1:9，这杯糖水的含糖率（糖占糖水的百分之几）是多少？",
          "correctAnswer": [
            "10%",
