            "type": "text",
            "x": 200,
            "y": 112,
            "text": "乘法分配律",
            "fontSize": 14,
            "textFill": "#6b7280",
            "data": { "anchor": "middle" }
          },
          {
            "id": "distributive-formula",
            "type": "text",
            "x": 200,
            "y": 140,
            "text": "a × (b + c) = a×b + a×c",
