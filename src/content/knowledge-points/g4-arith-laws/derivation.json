    {
      "title": "乘法交换律的结论",
      "narration": "不管是3×4还是4×3，结果都是12。这就是乘法交换律：两个数相乘，交换位置，积不变。用字母表示就是 a × b = b × a。",
      "scene": {
        "shapes": [
          {
            "id": "commutative-box",
            "type": "rect",
            "x": 80,
            "y": 100,
            "width": 240,
            "height": 60,
            "fill": "#eef2ff",
            "stroke": "#6366f1",
            "strokeWidth": 2,
            "radius": 8
          },
          {
            "id": "commutative-label",
            "type": "text",
            "x": 200,
            "y": 120,
            "text": "乘法交换律",
            "fontSize": 14,
            "textFill": "#6b7280",
            "data": { "anchor": "middle" }
          },
          {
            "id": "commutative-formula",
            "type": "text",
            "x": 200,
            "y": 145,
            "text": "a × b = b × a",
            "fontSize": 22,
            "textFill": "#4f46e5",
            "data": { "anchor": "middle" }
          }
        ],
        "labels": [
          { "text": "交换因数的位置，积不变", "x": 200, "y": 210, "fontSize": 14, "fill": "#6b7280" },
          { "text": "例：25 × 4 = 4 × 25 = 100", "x": 200, "y": 235, "fontSize": 13, "fill": "#9ca3af" }
        ],
        "formula": "a × b = b × a"
      },
      "hint": "交换两个因数的位置，积不变"
    },
    {
