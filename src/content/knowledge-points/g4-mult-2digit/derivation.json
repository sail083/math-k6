            "radius": 8
          },
          {
            "id": "step1-text",
            "type": "text",
            "x": 200,
            "y": 110,
            "text": "1. 用个位乘 → a × 个位",
            "fontSize": 15,
            "textFill": "#4f46e5"
          },
          {
            "id": "step2-text",
            "type": "text",
            "x": 200,
            "y": 140,
            "text": "2. 用十位乘 → a × 十位",
            "fontSize": 15,
            "textFill": "#4f46e5"
          },
          {
            "id": "step3-text",
            "type": "text",
            "x": 200,
            "y": 170,
            "text": "3. 两个积相加",
            "fontSize": 15,
            "textFill": "#4f46e5"
          }
        ],
        "labels": [
          { "text": "a × b = a×十位 + a×个位", "x": 200, "y": 230, "fontSize": 15, "fill": "#6b7280" }
        ],
        "formula": "a × b = a × (十位 + 个位)"
