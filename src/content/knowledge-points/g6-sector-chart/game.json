{
  "knowledgePointId": "g6-sector-chart",
  "passThreshold": 0.8,
  "questions": [
    {
      "id": "q1",
      "type": "choice",
      "prompt": "扇形统计图最大的优点是什么？",
      "options": [
        "能看出具体数量",
        "清楚地反映各部分与整体之间的关系",
        "能看出数据的变化趋势",
        "能比较两个数据的大小"
      ],
      "correctAnswer": "清楚地反映各部分与整体之间的关系",
      "explanation": "扇形统计图用整个圆表示总数，各扇形表示部分占总数的百分比，最大的优点是清楚地反映各部分与整体之间的关系。",
      "points": 10
    },
    {
      "id": "q2",
      "type": "choice",
      "prompt": "扇形统计图中所有扇形的百分比之和应该等于多少？",
      "options": [
        "50%",
        "90%",
        "100%",
        "不一定"
      ],
      "correctAnswer": "100%",
      "explanation": "扇形统计图用整个圆表示总数（100%），所有部分加起来就是全部，所以百分比之和一定等于100%。",
      "points": 10
    },
    {
      "id": "q3",
      "type": "choice",
      "prompt": "全班40人，喜欢足球的占30%，喜欢足球的有多少人？",
      "options": [
        "12人",
        "30人",
        "10人",
        "14人"
      ],
      "correctAnswer": "12人",
      "explanation": "40 × 30% = 40 × 0.3 = 12（人）。已知总数和百分比，用总数乘百分比求部分数量。",
      "points": 10
    },
    {
      "id": "q4",
      "type": "choice",
      "prompt": "喜欢乒乓球的有8人，占全班的20%，全班有多少人？",
      "options": [
        "20人",
        "40人",
        "16人",
        "8人"
      ],
      "correctAnswer": "40人",
      "explanation": "总数 = 部分数量 ÷ 百分比 = 8 ÷ 20% = 8 ÷ 0.2 = 40（人）。",
      "points": 10
    },
    {
      "id": "q5",
      "type": "choice",
      "prompt": "想表示一周气温的变化趋势，选哪种统计图最合适？",
      "options": [
        "扇形统计图",
        "条形统计图",
        "折线统计图",
        "都可以"
      ],
      "correctAnswer": "折线统计图",
      "explanation": "折线统计图最能反映数据的变化趋势。扇形图看占比关系，条形图比较数量多少，折线图看变化趋势。",
      "points": 10
    },
    {
      "id": "q6",
      "type": "fill-blank",
      "prompt": "某类占总数的25%，对应扇形圆心角是____度。",
      "correctAnswer": "90",
      "explanation": "25%×360°=90°。所有圆心角合计360°。",
      "points": 10
    }
  ],
  "reviewSets": {
    "d1": {
      "questions": [
        {
          "id": "d1-choice",
          "type": "choice",
          "prompt": "扇形统计图中，四个扇形分别占总数的15%、25%、35%和25%，占总数最多的那部分对应多少人？（总数为200人）",
          "options": [
            "30人",
            "50人",
            "70人",
            "100人"
          ],
          "correctAnswer": "70人",
          "explanation": "占总数最多的是35%。200 × 35% = 200 × 0.35 = 70（人）。四个百分比之和 = 15% + 25% + 35% + 25% = 100%。",
          "points": 10
        },
        {
          "id": "d1-fill",
          "type": "fill-blank",
          "prompt": "某校360名学生参加课外活动，科技类占40%，艺术类占25%，艺术类有多少人？",
          "correctAnswer": [
            "90",
            "90人"
          ],
          "explanation": "艺术类人数 = 总人数 × 百分比 = 360 × 25% = 360 × 0.25 = 90（人）。",
          "points": 10
        }
      ]
    },
    "d7": {
      "questions": [
        {
          "id": "d7-choice",
          "type": "choice",
          "prompt": "扇形统计图中，A类占40%有144人，B类占25%，B类有多少人？",
          "options": [
            "60人",
            "75人",
            "90人",
            "100人"
          ],
          "correctAnswer": "90人",
          "explanation": "由 A类 144人占40% 得总人数 = 144 ÷ 40% = 144 ÷ 0.4 = 360（人）。B类人数 = 360 × 25% = 360 × 0.25 = 90（人）。",
          "points": 10
        },
        {
          "id": "d7-fill",
          "type": "fill-blank",
          "prompt": "扇形统计图中某部分占30%，对应的扇形圆心角是多少度？",
          "correctAnswer": [
            "108",
            "108度",
            "108°"
          ],
          "explanation": "圆心角 = 百分比 × 360° = 30% × 360° = 0.3 × 360° = 108°。",
          "points": 10
        }
      ]
    }
  }
}
