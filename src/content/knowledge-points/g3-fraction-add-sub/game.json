    {
      "id": "q1",
      "type": "choice",
      "prompt": "1/5 + 2/5 = ？",
      "options": ["3/10", "3/5", "2/5", "1/5"],
      "correctAnswer": "3/5",
      "explanation": "同分母分数加法：分母不变，分子相加。1/5 + 2/5 = (1+2)/5 = 3/5。分母还是5，分子1+2=3。",
      "points": 10,
      "primarySkillId": "frac.add_sub_same_denominator",
      "evidenceType": "procedural"
    },
    {
      "id": "q2",
