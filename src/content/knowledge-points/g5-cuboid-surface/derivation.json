      "hint": "上下面=a×b，前后面=a×h，左右面=b×h"
    },
    {
      "title": "得出公式",
      "narration": "6个面的面积 = 2×(a×b) + 2×(a×h) + 2×(b×h) = 2×(ab + ah + bh)。所以长方体表面积 = 2 × (长×宽 + 长×高 + 宽×高)！",
      "scene": {
        "shapes": [
          {
            "id": "formula-box",
            "type": "rect",
            "x": 60,
            "y": 80,
            "width": 280,
            "height": 120,
            "fill": "#eef2ff",
            "stroke": "#6366f1",
            "strokeWidth": 2,
            "radius": 8
          },
          {
            "id": "f-line1",
            "type": "text",
            "x": 200,
            "y": 110,
            "text": "上面+下面 = 2×a×b",
            "fontSize": 15,
            "textFill": "#3b82f6",
            "data": { "anchor": "middle" }
          },
          {
            "id": "f-line2",
            "type": "text",
            "x": 200,
            "y": 140,
            "text": "前面+后面 = 2×a×h",
            "fontSize": 15,
            "textFill": "#6366f1",
            "data": { "anchor": "middle" }
          },
          {
            "id": "f-line3",
            "type": "text",
            "x": 200,
            "y": 170,
            "text": "左面+右面 = 2×b×h",
            "fontSize": 15,
            "textFill": "#f59e0b",
            "data": { "anchor": "middle" }
          }
        ],
        "labels": [
          { "text": "三个部分加起来", "x": 200, "y": 225, "fontSize": 13, "fill": "#6b7280" }
        ],
        "formula": "S = 2(ab + ah + bh)"
      },
      "hint": "三对面面积之和 = 2×(ab + ah + bh)"
    }
