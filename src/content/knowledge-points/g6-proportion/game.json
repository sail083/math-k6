{
  "knowledgePointId": "g6-proportion",
  "passThreshold": 0.8,
  "questions": [
    {
      "id": "q1",
      "type": "choice",
      "prompt": "下面哪组比能组成比例？",
      "options": [
        "2:3 和 4:5",
        "1:2 和 3:6",
        "2:4 和 3:5",
        "1:3 和 2:5"
      ],
      "correctAnswer": "1:2 和 3:6",
      "explanation": "1:2 = 0.5，3:6 = 0.5，比值相等，能组成比例。验证：外项积 1×6=6，内项积 2×3=6，相等。",
      "points": 10
    },
    {
      "id": "q2",
      "type": "choice",
      "prompt": "比例的基本性质是什么？",
      "options": [
        "两个外项的和等于两个内项的和",
        "两个外项的积等于两个内项的积",
        "两个外项的差等于两个内项的差",
        "两个外项的商等于两个内项的商"
      ],
      "correctAnswer": "两个外项的积等于两个内项的积",
      "explanation": "比例的基本性质：在比例中，两个外项的积等于两个内项的积。如 2:3=4:6 中，2×6=12，3×4=12。",
      "points": 10
    },
    {
      "id": "q3",
      "type": "fill-blank",
      "prompt": "解比例：3:4 = x:20，x等于多少？（请直接填写数字）",
      "correctAnswer": "15",
      "explanation": "根据基本性质：3×20 = 4×x → 60 = 4x → x = 15。",
      "points": 10
    },
    {
      "id": "q4",
      "type": "choice",
      "prompt": "路程一定，速度和时间成什么比例？",
      "options": [
        "正比例",
        "反比例",
        "不成比例",
        "无法确定"
      ],
      "correctAnswer": "反比例",
      "explanation": "速度 × 时间 = 路程（一定），乘积不变，所以速度和时间成反比例。速度越快，时间越短。",
      "points": 10
    },
    {
      "id": "q5",
      "type": "choice",
      "prompt": "买同一种苹果，单价一定，总价和数量成什么比例？",
      "options": [
        "正比例",
        "反比例",
        "不成比例",
        "无法确定"
      ],
      "correctAnswer": "正比例",
      "explanation": "总价 ÷ 数量 = 单价（一定），比值不变，所以总价和数量成正比例。买得越多，花钱越多。",
      "points": 10
    },
    {
      "id": "q6",
      "type": "true-false",
      "prompt": "2:3和8:12能组成比例，因为2×12=3×8。",
      "correctAnswer": "对",
      "explanation": "两个比的交叉乘积都等于24，所以两个比值相等，能组成比例。",
      "points": 10
    }
  ],
  "reviewSets": {
    "d1": {
      "questions": [
        {
          "id": "d1-choice",
          "type": "choice",
          "prompt": "下面哪组中的两个比能组成比例？",
          "options": [
            "15:25 和 3:5",
            "3:6 和 6:3",
            "1:4 和 4:1",
            "2:7 和 7:2"
          ],
          "correctAnswer": "15:25 和 3:5",
          "explanation": "15:25 = 15 ÷ 25 = 0.6，3:5 = 3 ÷ 5 = 0.6，比值相等，能组成比例。验证：15 × 5 = 75，25 × 3 = 75，外项积等于内项积。",
          "points": 10
        },
        {
          "id": "d1-fill",
          "type": "fill-blank",
          "prompt": "解比例：5:8 = x:40，x等于多少？",
          "correctAnswer": [
            "25"
          ],
          "explanation": "根据比例的基本性质：5 × 40 = 8 × x → 200 = 8x → x = 200 ÷ 8 = 25。",
          "points": 10
        }
      ]
    },
    "d7": {
      "questions": [
        {
          "id": "d7-choice",
          "type": "choice",
          "prompt": "如果 x 和 y 都是正数，且 x × y = 12（一定），那么 x 和 y 成什么比例？",
          "options": [
            "正比例",
            "反比例",
            "不成比例",
            "无法确定"
          ],
          "correctAnswer": "反比例",
          "explanation": "x 与 y 都是正数，且乘积始终等于12（常数），一个增大另一个就减小，满足反比例的定义：xy = k（k为非零常数）。",
          "points": 10
        },
        {
          "id": "d7-fill",
          "type": "fill-blank",
          "prompt": "把 0.25 : ⅔ 化成最简整数比，结果是____。",
          "correctAnswer": [
            "3:8",
            "3：8"
          ],
          "explanation": "0.25 = ¼，比值 = ¼ ÷ ⅔ = ¼ × 3/2 = 3/8，最简整数比为 3:8。",
          "points": 10
        }
      ]
    }
  }
}
