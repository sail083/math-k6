        "labels": [
          { "text": "圆柱有哪些面？", "x": 200, "y": 260, "fontSize": 14, "fill": "#6b7280" }
        ],
        "highlight": ["top-circle", "side-left", "side-right", "bot-circle"]
      },
      "hint": "圆柱表面 = 侧面 + 上底面 + 下底面"
    },
    {
      "title": "展开侧面",
      "narration": "把圆柱的侧面剪开展开，它变成了一个长方形！长方形的长 = 底面周长 = 2πr，长方形的宽 = 圆柱的高 = h。",
      "scene": {
        "shapes": [
          {
            "id": "rect-side",
            "type": "rect",
            "x": 100,
            "y": 100,
            "width": 200,
            "height": 100,
            "fill": "#dbeafe",
            "stroke": "#3b82f6",
            "strokeWidth": 2
          },
          {
            "id": "len-label",
            "type": "text",
            "x": 200,
            "y": 76,
            "text": "长 = 2πr（周长）",
            "fontSize": 13,
            "textFill": "#3b82f6",
            "data": { "anchor": "middle" }
          },
          {
            "id": "wid-label",
            "type": "text",
            "x": 72,
            "y": 150,
            "text": "宽=h",
            "fontSize": 13,
            "textFill": "#f59e0b",
            "data": { "anchor": "middle" }
          }
        ],
        "labels": [
          { "text": "侧面展开 = 长方形", "x": 200, "y": 230, "fontSize": 14, "fill": "#374151" }
        ],
        "highlight": ["rect-side"]
      },
      "hint": "侧面展开后长 = 周长 = 2πr，宽 = 高 = h"
    },
    {
      "title": "侧面积 + 底面积",
      "narration": "侧面展开成长方形，面积 = 长 × 宽 = 2πr × h = 2πrh。上下两个底面各是一个圆，面积 = 2 × πr² = 2πr²。",
      "scene": {
