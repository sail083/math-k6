{
  "knowledgePointId": "g3-fraction-intro",
  "passThreshold": 0.8,
  "questions": [
    {
      "id": "q1",
      "type": "choice",
      "prompt": "把一个饼平均分成4份，取其中的1份，用分数怎么表示？",
      "options": ["1/4", "4/1", "1/3", "3/4"],
      "correctAnswer": "1/4",
      "explanation": "平均分成4份（分母=4），取1份（分子=1），所以是1/4，读作四分之一。",
      "points": 10,
      "primarySkillId": "frac.equal_partition",
      "evidenceType": "conceptual"
    },
    {
      "id": "q2",
      "type": "choice",
      "prompt": "分数 3/5 中，5 是什么？",
      "options": ["分子", "分母", "分数线", "整数"],
      "correctAnswer": "分母",
      "explanation": "分数中下面的数叫分母，表示平均分成几份。5在下面，是分母，表示平均分成5份。上面的3是分子，表示取了3份。",
      "points": 10,
      "primarySkillId": "frac.notation",
      "evidenceType": "conceptual"
    },
    {
      "id": "q3",
      "type": "choice",
      "prompt": "3/4 读作什么？",
      "options": ["三分之四", "四分之三", "三四", "三除以四"],
      "correctAnswer": "四分之三",
      "explanation": "读分数时先读分母再读分子。分母是4，分子是3，所以读作四分之三。",
      "points": 10,
      "primarySkillId": "frac.notation",
      "evidenceType": "procedural"
    },
    {
      "id": "q4",
      "type": "choice",
      "prompt": "下面哪种情况可以用分数 1/2 表示？",
      "options": [
        "把一个西瓜随便切成两块，大的一块",
        "把一个西瓜平均切成两块，取其中一块",
        "把一个西瓜切成三块，取其中一块",
        "把两个西瓜平均分给一个人"
      ],
      "correctAnswer": "把一个西瓜平均切成两块，取其中一块",
      "explanation": "分数必须是平均分的结果。只有平均分成2份，取1份，才是1/2。随便切不是平均分，切成3块也不是2份。",
      "points": 10,
      "primarySkillId": "frac.whole",
      "secondarySkillIds": ["frac.equal_partition"],
      "evidenceType": "conceptual"
    },
    {
      "id": "q5",
      "type": "choice",
      "prompt": "把一根绳子平均分成6份，取其中的5份，用分数怎么表示？",
      "options": ["5/6", "6/5", "1/6", "5/1"],
      "correctAnswer": "5/6",
      "explanation": "平均分成6份（分母=6），取5份（分子=5），所以是5/6，读作六分之五。",
      "points": 10,
      "primarySkillId": "frac.multiple_units",
      "secondarySkillIds": ["frac.notation"],
      "evidenceType": "procedural"
    },
    {
      "id": "q6",
      "type": "fill-blank",
      "prompt": "把一个整体平均分成5份，取其中3份，写成分数是____。",
      "correctAnswer": "3/5",
      "explanation": "分母5表示平均分成5份，分子3表示取了3份。",
      "points": 10,
      "primarySkillId": "frac.multiple_units",
      "secondarySkillIds": ["frac.notation"],
      "evidenceType": "transfer"
    }
  ],
