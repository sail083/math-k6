{
  "knowledgePointId": "g6-scale",
  "passThreshold": 0.8,
  "questions": [
    {
      "id": "q1",
      "type": "choice",
      "prompt": "把一个长方形按2:1放大，放大后每条边是原来的几倍？",
      "options": [
        "1倍",
        "2倍",
        "4倍",
        "½倍"
      ],
      "correctAnswer": "2倍",
      "explanation": "按2:1放大，就是每条边都乘以2。长和宽都变成原来的2倍，但图形的形状不变。",
      "points": 10
    },
    {
      "id": "q2",
      "type": "choice",
      "prompt": "一个正方形边长4厘米，按1:2缩小后，边长是多少？",
      "options": [
        "8厘米",
        "2厘米",
        "1厘米",
        "4厘米"
      ],
      "correctAnswer": "2厘米",
      "explanation": "按1:2缩小，每条边除以2。4 ÷ 2 = 2（厘米）。",
      "points": 10
    },
    {
      "id": "q3",
      "type": "choice",
      "prompt": "一个长方形按3:1放大后，面积是原来的多少倍？",
      "options": [
        "3倍",
        "6倍",
        "9倍",
        "12倍"
      ],
      "correctAnswer": "9倍",
      "explanation": "每条边放大3倍，面积 = 3 × 3 = 9倍。面积变化倍数 = 边长变化倍数的平方。",
      "points": 10
    },
    {
      "id": "q4",
      "type": "choice",
      "prompt": "地图上比例尺是1:100000，图上3厘米代表实际距离多少？",
      "options": [
        "3千米",
        "30千米",
        "300米",
        "3000米"
      ],
      "correctAnswer": "3千米",
      "explanation": "实际距离 = 3 × 100000 = 300000厘米 = 3000米 = 3千米。比例尺1:100000表示图上1厘米代表实际1千米。",
      "points": 10
    },
    {
      "id": "q5",
      "type": "choice",
      "prompt": "图上距离5厘米，实际距离50千米，比例尺是多少？",
      "options": [
        "1:1000",
        "1:10000",
        "1:100000",
        "1:1000000"
      ],
      "correctAnswer": "1:1000000",
      "explanation": "50千米 = 5000000厘米。比例尺 = 5 : 5000000 = 1 : 1000000。计算比例尺时单位要统一。",
      "points": 10
    },
    {
      "id": "q6",
      "type": "fill-blank",
      "prompt": "迁移题：点(2,1)以原点为中心放大3倍后，坐标是多少？请写成(x,y)。",
      "correctAnswer": [
        "(6,3)",
        "（6，3）",
        "6,3"
      ],
      "explanation": "以原点为中心放大3倍，横坐标和纵坐标都乘3：(2×3,1×3)=(6,3)。",
      "points": 10
    }
  ],
  "reviewSets": {
    "d1": {
      "questions": [
        {
          "id": "d1-choice",
          "type": "choice",
          "prompt": "一幅图纸的比例尺是20:1，图纸上一个零件长6厘米，这个零件的实际长度是多少？",
          "options": [
            "120厘米",
            "3厘米",
            "0.3厘米",
            "1.2厘米"
          ],
          "correctAnswer": "0.3厘米",
          "explanation": "比例尺20:1表示图上长度是实际长度的20倍。实际长度 = 6 ÷ 20 = 0.3（厘米）。注意这是放大比例尺，图上大于实际。",
          "points": 10
        },
        {
          "id": "d1-fill",
          "type": "fill-blank",
          "prompt": "一幅地图的比例尺是1:2000000，图上两地距离8厘米，实际距离是多少千米？",
          "correctAnswer": [
            "160",
            "160千米"
          ],
          "explanation": "实际距离 = 8 × 2000000 = 16000000（厘米）= 160000（米）= 160（千米）。",
          "points": 10
        }
      ]
    },
    "d7": {
      "questions": [
        {
          "id": "d7-choice",
          "type": "choice",
          "prompt": "把一个正方形按1:3缩小，缩小后的面积是原来的多少？",
          "options": [
            "1/3",
            "1/6",
            "1/9",
            "1/12"
          ],
          "correctAnswer": "1/9",
          "explanation": "每条边缩小到原来的⅓，面积 = ⅓ × ⅓ = 1/9。面积变化倍数 = 边长变化倍数的平方，(⅓)² = 1/9。",
          "points": 10
        },
        {
          "id": "d7-fill",
          "type": "fill-blank",
          "prompt": "一个正方形边长8厘米，按1:4缩小后，面积是多少平方厘米？",
          "correctAnswer": [
            "4",
            "4平方厘米"
          ],
          "explanation": "缩小后边长 = 8 ÷ 4 = 2（厘米），面积 = 2 × 2 = 4（平方厘米）。也可以：原面积64 × (1/4)² = 64 × 1/16 = 4（平方厘米）。",
          "points": 10
        }
      ]
    }
  }
}
