{
  "knowledgePointId": "g6-cone-volume",
  "passThreshold": 0.8,
  "questions": [
    {
      "id": "q1",
      "type": "choice",
      "prompt": "圆锥体积公式是什么？",
      "options": [
        "V = πr²h",
        "V = ⅓πr²h",
        "V = 3πr²h",
        "V = πr²h ÷ 2"
      ],
      "correctAnswer": "V = ⅓πr²h",
      "explanation": "圆锥体积 = ⅓ × 圆柱体积 = ⅓ × πr²h = ⅓πr²h。3个等底等高的圆锥才能填满1个圆柱。",
      "points": 10
    },
    {
      "id": "q2",
      "type": "choice",
      "prompt": "等底等高的圆锥和圆柱，圆锥体积是圆柱体积的多少？",
      "options": [
        "½",
        "⅓",
        "2倍",
        "3倍"
      ],
      "correctAnswer": "⅓",
      "explanation": "沙子实验证明：3个圆锥的沙子正好装满1个等底等高的圆柱，所以圆锥体积 = 圆柱体积的 ⅓。",
      "points": 10
    },
    {
      "id": "q3",
      "type": "choice",
      "prompt": "圆锥底面半径3厘米，高6厘米，体积是多少？（π取3.14）",
      "options": [
        "56.52立方厘米",
        "169.56立方厘米",
        "28.26立方厘米",
        "113.04立方厘米"
      ],
      "correctAnswer": "56.52立方厘米",
      "explanation": "底面积 = 3.14 × 9 = 28.26；V = ⅓ × 28.26 × 6 = ⅓ × 169.56 = 56.52（立方厘米）。",
      "points": 10
    },
    {
      "id": "q4",
      "type": "choice",
      "prompt": "一个圆柱体积是150立方厘米，与它等底等高的圆锥体积是多少？",
      "options": [
        "50立方厘米",
        "100立方厘米",
        "450立方厘米",
        "75立方厘米"
      ],
      "correctAnswer": "50立方厘米",
      "explanation": "等底等高时，圆锥体积 = 圆柱体积 ÷ 3 = 150 ÷ 3 = 50（立方厘米）。",
      "points": 10
    },
    {
      "id": "q5",
      "type": "choice",
      "prompt": "圆锥底面直径4分米，高9分米，体积是多少？（π取3.14）",
      "options": [
        "37.68立方分米",
        "113.04立方分米",
        "150.72立方分米",
        "12.56立方分米"
      ],
      "correctAnswer": "37.68立方分米",
      "explanation": "r = 4÷2 = 2；底面积 = 3.14 × 4 = 12.56；V = ⅓ × 12.56 × 9 = ⅓ × 113.04 = 37.68（立方分米）。",
      "points": 10
    },
    {
      "id": "q6",
      "type": "fill-blank",
      "prompt": "等底等高的圆柱体积是30立方厘米，圆锥体积是____立方厘米。",
      "correctAnswer": "10",
      "explanation": "等底等高时圆锥体积是圆柱的三分之一，30÷3=10。",
      "points": 10
    }
  ],
  "reviewSets": {
    "d1": {
      "questions": [
        {
          "id": "d1-choice",
          "type": "choice",
          "prompt": "圆锥的底面半径扩大到原来的2倍，高扩大到原来的3倍，体积扩大到原来的多少倍？",
          "options": [
            "12倍",
            "6倍",
            "5倍",
            "9倍"
          ],
          "correctAnswer": "12倍",
          "explanation": "V = ⅓πr²h，半径扩大2倍后 r² 变为 (2r)² = 4r²，高扩大3倍，新体积 = ⅓π(2r)²(3h) = 12 × ⅓πr²h，扩大12倍。",
          "points": 10
        },
        {
          "id": "d1-fill",
          "type": "fill-blank",
          "prompt": "圆锥的底面周长是12.56厘米，高是9厘米，体积是多少立方厘米？（π取3.14）",
          "correctAnswer": [
            "37.68",
            "37.68立方厘米"
          ],
          "explanation": "由底面周长 2πr = 12.56 得 r = 2（厘米）。V = ⅓πr²h = ⅓ × 3.14 × 4 × 9 = ⅓ × 113.04 = 37.68（立方厘米）。",
          "points": 10
        }
      ]
